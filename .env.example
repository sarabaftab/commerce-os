# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Prisma)
# Pooled connection (runtime) — Supabase Transaction mode / PgBouncer port 6543
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (migrations) — port 5432
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Seed — UUID of the Supabase Auth user for admin@kina2.com
SEED_ADMIN_SUPABASE_USER_ID=
SEED_ADMIN_EMAIL=admin@kina2.com

# Show on-page timing badge on admin routes (1 = on)
TIMING_DEBUG=1

# Default storefront tenant slug (used by / redirect)
DEFAULT_TENANT_SLUG=kin-a2
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=kin-a2
