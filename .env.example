# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Prisma)
# Runtime: session-mode pooler (port 5432) — required for Prisma $transaction (checkout).
# Do not use transaction-mode port 6543 for DATABASE_URL or interactive txs fail with P2028.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Same session pooler for migrations when direct db.* host is unreachable (IPv6)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Seed — UUID of the Supabase Auth user for admin@kina2.com
SEED_ADMIN_SUPABASE_USER_ID=
SEED_ADMIN_EMAIL=admin@kina2.com
# Production: leave unset. Dev-only: ALLOW_ADMIN_EMAIL_LINK=1 to link seed user by email
# ALLOW_ADMIN_EMAIL_LINK=1

# Show on-page timing badge on admin routes (1 = on)
TIMING_DEBUG=1

# Default storefront tenant slug (used by / redirect)
DEFAULT_TENANT_SLUG=kin-a2
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=kin-a2

# Telegram Mini App (Phase 1: one bot → one tenant slug)
# See docs/telegram.md for BotFather + HTTPS tunnel setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_TENANT_SLUG=kin-a2
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
# Use SameSite=None; Secure customer cookies in local HTTPS tunnels
# TELEGRAM_FORCE_SECURE_COOKIES=1
CUSTOMER_SESSION_TTL_SECONDS=2592000
