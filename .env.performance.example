# Non-secret template for capacity / performance runs.
# Copy into .env / .env.local (gitignored). Never commit real secrets.
# If a password or service_role was pasted in chat, rotate it in Supabase.

# --- App under test ---
# PERF_BASE_URL=http://localhost:3000
# PERF_TENANT_SLUG=kin-a2
# PERF_PRODUCT_SLUG=

# --- Required safety ack for npm run load:ramp (fail closed without these) ---
# LOAD_TEST_ENV=local
# LOAD_TEST_ENV=staging
# LOAD_TEST_ACK=I_CONFIRM_NON_PRODUCTION
# LOAD_BASE_URL=http://localhost:3000
# LOAD_TENANT_SLUG=kin-a2
# LOAD_LEVELS=1,5,10,20
# LOAD_DURATION_MS=8000

# --- Database (session pooler port 5432; placeholders only) ---
# Must be a STAGING or local DB for claim-oriented runs — not production.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Checkout load (npm run load:checkout) ---
# LOAD_ALLOW_CHECKOUT=1
# LOAD_CHECKOUT_SERIAL=8
# LOAD_CHECKOUT_LEVELS=1,3,5,8,10
# LOAD_CHECKOUT_POOL=15
# LOAD_CHECKOUT_CLEANUP=1
