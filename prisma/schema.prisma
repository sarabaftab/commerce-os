generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  owner
  admin
  staff
}

enum IdentityChannel {
  telegram
  web
  manual
}

enum OrderStatus {
  pending
  confirmed
  processing
  ready_for_pickup
  out_for_delivery
  completed
  cancelled
}

enum PaymentMethod {
  cod
  aba_transfer
}

enum CartStatus {
  open
  converted
  abandoned
}

enum FulfillmentMethod {
  delivery
  pickup
}

enum SellingUnit {
  item
  pack
  case
}

model Tenant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  currency      String   @db.Char(3)
  isActive      Boolean  @default(true) @map("is_active")
  config        Json     @default("{}")
  orderSequence Int      @default(1) @map("order_sequence")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships        UserTenantMembership[]
  categories         Category[]
  products           Product[]
  customers          Customer[]
  customerIdentities CustomerIdentity[]
  orders             Order[]
  carts              Cart[]
  settings           TenantSettings?
  pickupLocations    PickupLocation[]
  customerSessions   CustomerSession[]
  customerAddresses  CustomerAddress[]
  faqs               Faq[]

  @@map("tenants")
}

model User {
  id             String   @id @default(cuid())
  supabaseUserId String?  @unique @map("supabase_user_id")
  email          String   @unique
  displayName    String?  @map("display_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  memberships UserTenantMembership[]

  @@map("users")
}

model UserTenantMembership {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  userId    String         @map("user_id")
  role      MembershipRole @default(admin)
  createdAt DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("user_tenant_memberships")
}

model Category {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  name      String
  slug      String
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt, isActive, sortOrder])
  @@map("categories")
}

model Product {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  categoryId  String?   @map("category_id")
  name        String
  slug        String
  description String?
  brand       String?
  volume      String?
  sellingUnit SellingUnit @default(item) @map("selling_unit")
  priceMinor  Int       @map("price_minor")
  currency    String    @db.Char(3)
  isAvailable Boolean   @default(true) @map("is_available")
  stockNote   String?   @map("stock_note")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media      ProductMedia[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, isAvailable])
  @@index([tenantId, deletedAt, isAvailable, sortOrder])
  @@index([tenantId, categoryId, deletedAt, isAvailable])
  @@index([categoryId])
  @@map("products")
}

model ProductMedia {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([tenantId])
  @@map("product_media")
}

model Customer {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  displayName String?   @map("display_name")
  phone       String?
  email       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identities CustomerIdentity[]
  orders     Order[]
  carts      Cart[]
  sessions   CustomerSession[]
  addresses  CustomerAddress[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("customers")
}

model CustomerAddress {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  customerId           String   @map("customer_id")
  label                String
  recipientFirstName   String   @map("recipient_first_name")
  recipientLastName    String   @map("recipient_last_name")
  phone                String
  addressLine1         String   @map("address_line_1")
  addressLine2         String?  @map("address_line_2")
  cityOrDistrict       String   @map("city_or_district")
  provinceOrState      String   @map("province_or_state")
  postalCode           String?  @map("postal_code")
  countryCode          String   @default("KH") @map("country_code") @db.Char(2)
  deliveryInstructions String?  @map("delivery_instructions")
  isDefault            Boolean  @default(false) @map("is_default")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, customerId, isActive])
  @@index([tenantId, customerId, isDefault])
  @@map("customer_addresses")
}

model CustomerIdentity {
  id                  String          @id @default(cuid())
  tenantId            String          @map("tenant_id")
  customerId          String          @map("customer_id")
  channel             IdentityChannel
  externalId          String          @map("external_id")
  meta                Json            @default("{}")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  lastAuthenticatedAt DateTime?       @map("last_authenticated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, externalId])
  @@index([customerId])
  @@map("customer_identities")
}

model CustomerSession {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model Order {
  id                        String            @id @default(cuid())
  tenantId                  String            @map("tenant_id")
  customerId                String            @map("customer_id")
  orderNumber               String            @map("order_number")
  status                    OrderStatus       @default(pending)
  fulfillmentMethod         FulfillmentMethod @map("fulfillment_method")
  addressLine               String?           @map("address_line")
  addressLine2              String?           @map("address_line_2")
  cityOrArea                String?           @map("city_or_area")
  provinceOrState           String?           @map("province_or_state")
  postalCode                String?           @map("postal_code")
  countryCode               String?           @map("country_code") @db.Char(2)
  recipientFirstName        String?           @map("recipient_first_name")
  recipientLastName         String?           @map("recipient_last_name")
  recipientPhone            String?           @map("recipient_phone")
  addressLabel              String?           @map("address_label")
  sourceAddressId           String?           @map("source_address_id")
  deliveryInstructions      String?           @map("delivery_instructions")
  pickupLocationKey         String?           @map("pickup_location_key")
  pickupLocationName        String?           @map("pickup_location_name")
  pickupLocationAddress     String?           @map("pickup_location_address")
  paymentMethod             PaymentMethod     @map("payment_method")
  paymentReference          String?           @map("payment_reference")
  currency                  String            @db.Char(3)
  subtotalMinor             Int               @map("subtotal_minor")
  deliveryFeeMinor          Int               @default(0) @map("delivery_fee_minor")
  discountMinor             Int               @default(0) @map("discount_minor")
  totalMinor                Int               @map("total_minor")
  notes                     String?
  channel                   IdentityChannel   @default(manual)
  // Optional attribution — stored only; no promotion/referral/campaign logic yet.
  promotionId               String?           @map("promotion_id")
  referralCode              String?           @map("referral_code")
  campaignId                String?           @map("campaign_id")
  idempotencyKey            String?           @map("idempotency_key")
  /** Opaque capability token for guest confirmation access — never use orderNumber alone. */
  confirmationToken         String            @unique @map("confirmation_token")
  placedAt                  DateTime          @default(now()) @map("placed_at")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, placedAt])
  @@index([tenantId, placedAt])
  @@index([tenantId, customerId, placedAt])
  @@index([customerId])
  @@index([tenantId, promotionId])
  @@index([tenantId, campaignId])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  tenantId       String  @map("tenant_id")
  orderId        String  @map("order_id")
  productId      String? @map("product_id")
  nameSnapshot         String       @map("name_snapshot")
  volumeSnapshot       String?      @map("volume_snapshot")
  sellingUnitSnapshot  SellingUnit? @map("selling_unit_snapshot")
  unitPriceMinor       Int          @map("unit_price_minor")
  quantity             Int
  lineTotalMinor       Int          @map("line_total_minor")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([tenantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  tenantId   String       @map("tenant_id")
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")
  createdBy  String?      @map("created_by")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Cart {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  customerId String?    @map("customer_id")
  guestToken String?    @map("guest_token")
  status     CartStatus @default(open)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@unique([tenantId, guestToken])
  @@index([tenantId, customerId, status])
  @@index([tenantId, status])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([tenantId])
  @@index([cartId])
  @@map("cart_items")
}

model TenantSettings {
  id                         String   @id @default(cuid())
  tenantId                   String   @unique @map("tenant_id")
  displayName                String?  @map("display_name")
  logoUrl                    String?  @map("logo_url")
  phone                      String?
  email                      String?
  address                    String?
  timezone                   String   @default("Asia/Phnom_Penh")
  businessHours              String?  @map("business_hours")
  deliveryEnabled            Boolean  @default(true) @map("delivery_enabled")
  deliveryFeeMinor           Int      @default(0) @map("delivery_fee_minor")
  freeDeliveryThresholdMinor Int?     @map("free_delivery_threshold_minor")
  deliveryNotes              String?  @map("delivery_notes")
  pickupEnabled              Boolean  @default(true) @map("pickup_enabled")
  codEnabled                 Boolean  @default(true) @map("cod_enabled")
  abaEnabled                 Boolean  @default(true) @map("aba_enabled")
  abaAccountName             String?  @map("aba_account_name")
  abaAccountNumber           String?  @map("aba_account_number")
  abaInstructions            String?  @map("aba_instructions")
  abaQrImageUrl              String?  @map("aba_qr_image_url")
  abaCustomerNote            String?  @map("aba_customer_note")
  primaryColor               String?  @map("primary_color")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model PickupLocation {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  address      String
  instructions String?
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, sortOrder])
  @@map("pickup_locations")
}

model Faq {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  question   String
  answer     String
  questionKm String?  @map("question_km")
  answerKm   String?  @map("answer_km")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, sortOrder])
  @@map("faqs")
}
