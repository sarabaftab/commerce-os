generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  owner
  admin
  staff
}

enum IdentityChannel {
  telegram
  web
  manual
}

enum OrderStatus {
  pending
  confirmed
  processing
  ready_for_pickup
  out_for_delivery
  completed
  cancelled
}

enum PaymentMethod {
  cod
  aba_transfer
}

enum PaymentProofStatus {
  not_required
  awaiting_proof
  submitted
  verified
  rejected
}

enum NotificationChannel {
  telegram
}

enum NotificationType {
  order_status
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
}

enum CartStatus {
  open
  converted
  abandoned
}

enum FulfillmentMethod {
  delivery
  pickup
}

enum SellingUnit {
  item
  pack
  case
}

enum PromotionDiscountType {
  percentage
  fixed
  /** Same-SKU buy 1 get 1 free — paid qty charged, fulfillment qty = paid × 2. */
  buy_one_get_one
}

model Tenant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  currency      String   @db.Char(3)
  isActive      Boolean  @default(true) @map("is_active")
  config        Json     @default("{}")
  orderSequence Int      @default(1) @map("order_sequence")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships        UserTenantMembership[]
  categories         Category[]
  products           Product[]
  customers          Customer[]
  customerIdentities CustomerIdentity[]
  orders             Order[]
  carts              Cart[]
  settings           TenantSettings?
  pickupLocations    PickupLocation[]
  customerSessions          CustomerSession[]
  telegramSessionHandoffs   TelegramSessionHandoff[]
  telegramAccountAccesses   TelegramAccountAccess[]
  customerAddresses         CustomerAddress[]
  faqs                      Faq[]
  notifications             CustomerNotification[]
  promotions                Promotion[]

  @@map("tenants")
}

model User {
  id             String   @id @default(cuid())
  supabaseUserId String?  @unique @map("supabase_user_id")
  email          String   @unique
  displayName    String?  @map("display_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  memberships UserTenantMembership[]

  @@map("users")
}

model UserTenantMembership {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  userId    String         @map("user_id")
  role      MembershipRole @default(admin)
  createdAt DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("user_tenant_memberships")
}

model Category {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  name      String
  /** Optional Khmer display name; English `name` remains canonical. */
  nameKm    String?   @map("name_km")
  /** Reserved from earlier migration — unused in EN/KM storefront. */
  nameZh    String?   @map("name_zh")
  slug      String
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt, isActive, sortOrder])
  @@map("categories")
}

model Product {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  categoryId  String?   @map("category_id")
  name        String
  /** Optional Khmer display name; English `name` remains canonical. */
  nameKm      String?   @map("name_km")
  /** Reserved from earlier migration — unused in EN/KM storefront. */
  nameZh      String?   @map("name_zh")
  slug        String
  description String?
  descriptionKm String? @map("description_km")
  /** Reserved from earlier migration — unused in EN/KM storefront. */
  descriptionZh String? @map("description_zh")
  brand       String?
  volume      String?
  sellingUnit SellingUnit @default(item) @map("selling_unit")
  priceMinor  Int       @map("price_minor")
  currency    String    @db.Char(3)
  isAvailable Boolean   @default(true) @map("is_available")
  /** Explicit homepage Featured eligibility (storefront also requires isAvailable). */
  isFeatured  Boolean   @default(false) @map("is_featured")
  /**
   * On-hand units for fulfillment. Null = legacy unlimited (isAvailable only).
   * Required for buy_one_get_one eligibility checks (floor(stock/2) sets).
   */
  stockQuantity Int?    @map("stock_quantity")
  stockNote   String?   @map("stock_note")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media      ProductMedia[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  promotionProducts PromotionProduct[]

  @@unique([tenantId, slug])
  @@index([tenantId, isAvailable])
  @@index([tenantId, deletedAt, isAvailable, sortOrder])
  @@index([tenantId, categoryId, deletedAt, isAvailable])
  @@index([categoryId])
  @@map("products")
}

model ProductMedia {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([tenantId])
  @@map("product_media")
}

model Customer {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  displayName     String?   @map("display_name")
  phone           String?
  /** Canonical E.164 for identity matching (e.g. +85512345678). Nullable until backfilled. */
  phoneNormalized String?   @map("phone_normalized")
  email           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identities CustomerIdentity[]
  orders     Order[]
  carts      Cart[]
  sessions   CustomerSession[]
  accountAccesses TelegramAccountAccess[]
  addresses     CustomerAddress[]
  notifications CustomerNotification[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, phoneNormalized])
  @@map("customers")
}

model CustomerAddress {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  customerId           String   @map("customer_id")
  label                String
  recipientFirstName   String   @map("recipient_first_name")
  recipientLastName    String   @map("recipient_last_name")
  phone                String
  addressLine1         String   @map("address_line_1")
  addressLine2         String?  @map("address_line_2")
  cityOrDistrict       String   @map("city_or_district")
  provinceOrState      String   @map("province_or_state")
  postalCode           String?  @map("postal_code")
  countryCode          String   @default("KH") @map("country_code") @db.Char(2)
  deliveryInstructions String?  @map("delivery_instructions")
  /** Confirmed delivery pin; optional so existing text-only addresses remain valid. */
  latitude             Float?
  longitude            Float?
  isDefault            Boolean  @default(false) @map("is_default")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, customerId, isActive])
  @@index([tenantId, customerId, isDefault])
  @@map("customer_addresses")
}

model CustomerIdentity {
  id                  String          @id @default(cuid())
  tenantId            String          @map("tenant_id")
  customerId          String          @map("customer_id")
  channel             IdentityChannel
  externalId          String          @map("external_id")
  meta                Json            @default("{}")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  lastAuthenticatedAt DateTime?       @map("last_authenticated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, externalId])
  @@index([customerId])
  @@map("customer_identities")
}

model CustomerSession {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  handoffs TelegramSessionHandoff[]
  accountAccesses TelegramAccountAccess[]

  @@index([tenantId, customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

/** Short-lived single-use codes for Desktop WebView cookie handoff. Never store raw session tokens here. */
model TelegramSessionHandoff {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  sessionId  String    @map("session_id")
  codeHash   String    @unique @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
  @@map("telegram_session_handoffs")
}

/**
 * Short-lived multi-use Account access proofs for Telegram Desktop when
 * commerceos_customer cookies do not persist. Opaque code only — never a session token.
 * Created only after verified Telegram initData.
 */
model TelegramAccountAccess {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  sessionId  String   @map("session_id")
  codeHash   String   @unique @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  session  CustomerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([expiresAt])
  @@map("telegram_account_accesses")
}

model Order {
  id                        String            @id @default(cuid())
  tenantId                  String            @map("tenant_id")
  customerId                String            @map("customer_id")
  orderNumber               String            @map("order_number")
  status                    OrderStatus       @default(pending)
  fulfillmentMethod         FulfillmentMethod @map("fulfillment_method")
  addressLine               String?           @map("address_line")
  addressLine2              String?           @map("address_line_2")
  cityOrArea                String?           @map("city_or_area")
  provinceOrState           String?           @map("province_or_state")
  postalCode                String?           @map("postal_code")
  countryCode               String?           @map("country_code") @db.Char(2)
  recipientFirstName        String?           @map("recipient_first_name")
  recipientLastName         String?           @map("recipient_last_name")
  recipientPhone            String?           @map("recipient_phone")
  addressLabel              String?           @map("address_label")
  sourceAddressId           String?           @map("source_address_id")
  deliveryInstructions      String?           @map("delivery_instructions")
  /** Snapshot of confirmed delivery pin at order time — never recalculated from saved addresses. */
  deliveryLatitude          Float?            @map("delivery_latitude")
  deliveryLongitude         Float?            @map("delivery_longitude")
  pickupLocationKey         String?           @map("pickup_location_key")
  pickupLocationName        String?           @map("pickup_location_name")
  pickupLocationAddress     String?           @map("pickup_location_address")
  paymentMethod                PaymentMethod       @map("payment_method")
  paymentReference             String?             @map("payment_reference")
  paymentProofStatus           PaymentProofStatus  @default(not_required) @map("payment_proof_status")
  paymentProofPath             String?             @map("payment_proof_path")
  paymentProofContentType      String?             @map("payment_proof_content_type")
  paymentProofSubmittedAt      DateTime?           @map("payment_proof_submitted_at")
  paymentProofReviewedAt       DateTime?           @map("payment_proof_reviewed_at")
  paymentProofRejectionReason  String?             @map("payment_proof_rejection_reason")
  currency                  String            @db.Char(3)
  subtotalMinor             Int               @map("subtotal_minor")
  deliveryFeeMinor          Int               @default(0) @map("delivery_fee_minor")
  discountMinor             Int               @default(0) @map("discount_minor")
  totalMinor                Int               @map("total_minor")
  notes                     String?
  channel                   IdentityChannel   @default(manual)
  // Optional attribution — stored only; no promotion/referral/campaign logic yet.
  promotionId               String?           @map("promotion_id")
  /** Snapshot of campaign name at order time — never recalculated from live promotions. */
  promotionNameSnapshot     String?           @map("promotion_name_snapshot")
  referralCode              String?           @map("referral_code")
  campaignId                String?           @map("campaign_id")
  idempotencyKey            String?           @map("idempotency_key")
  /** Opaque capability token for guest confirmation access — never use orderNumber alone. */
  confirmationToken         String            @unique @map("confirmation_token")
  /** Snapshot of customer UI locale at checkout (`en` | `km`) for notifications. */
  customerLocale            String?           @map("customer_locale") @db.VarChar(8)
  placedAt                  DateTime          @default(now()) @map("placed_at")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  notifications CustomerNotification[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, placedAt])
  @@index([tenantId, placedAt])
  @@index([tenantId, customerId, placedAt])
  @@index([customerId])
  @@index([tenantId, promotionId])
  @@index([tenantId, campaignId])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  tenantId       String  @map("tenant_id")
  orderId        String  @map("order_id")
  productId      String? @map("product_id")
  nameSnapshot         String       @map("name_snapshot")
  volumeSnapshot       String?      @map("volume_snapshot")
  sellingUnitSnapshot  SellingUnit? @map("selling_unit_snapshot")
  unitPriceMinor       Int          @map("unit_price_minor")
  /** Customer-selected / paid quantity (lineTotal = unitPrice × quantity). */
  quantity             Int
  /** Free units from buy_one_get_one (same SKU). Snapshot — never re-derived. */
  freeQuantity         Int          @default(0) @map("free_quantity")
  /** Physical units to ship / inventory deducted. Snapshot — never re-derived. */
  fulfillmentQuantity  Int          @map("fulfillment_quantity")
  lineTotalMinor       Int          @map("line_total_minor")
  /** Line-level promotion snapshot (e.g. buy_one_get_one) — independent of live promo. */
  promotionIdSnapshot     String? @map("promotion_id_snapshot")
  promotionNameSnapshot   String? @map("promotion_name_snapshot")
  promotionTypeSnapshot   String? @map("promotion_type_snapshot")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([tenantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  tenantId   String       @map("tenant_id")
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")
  createdBy  String?      @map("created_by")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model CustomerNotification {
  id                  String                     @id @default(cuid())
  tenantId            String                     @map("tenant_id")
  customerId          String                     @map("customer_id")
  orderId             String                     @map("order_id")
  channel             NotificationChannel
  type                NotificationType
  toStatus            OrderStatus                @map("to_status")
  recipientExternalId String?                    @map("recipient_external_id")
  status              NotificationDeliveryStatus @default(pending)
  attemptCount        Int                        @default(0) @map("attempt_count")
  lastAttemptAt       DateTime?                  @map("last_attempt_at")
  sentAt              DateTime?                  @map("sent_at")
  errorCode           String?                    @map("error_code") @db.VarChar(64)
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, channel, type, toStatus])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("customer_notifications")
}

model Cart {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  customerId String?    @map("customer_id")
  guestToken String?    @map("guest_token")
  status     CartStatus @default(open)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@unique([tenantId, guestToken])
  @@index([tenantId, customerId, status])
  @@index([tenantId, status])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([tenantId])
  @@index([cartId])
  @@map("cart_items")
}

model TenantSettings {
  id                         String   @id @default(cuid())
  tenantId                   String   @unique @map("tenant_id")
  displayName                String?  @map("display_name")
  logoUrl                    String?  @map("logo_url")
  phone                      String?
  email                      String?
  address                    String?
  timezone                   String   @default("Asia/Phnom_Penh")
  businessHours              String?  @map("business_hours")
  deliveryEnabled            Boolean  @default(true) @map("delivery_enabled")
  deliveryFeeMinor           Int      @default(0) @map("delivery_fee_minor")
  freeDeliveryThresholdMinor Int?     @map("free_delivery_threshold_minor")
  deliveryNotes              String?  @map("delivery_notes")
  pickupEnabled              Boolean  @default(true) @map("pickup_enabled")
  codEnabled                 Boolean  @default(true) @map("cod_enabled")
  abaEnabled                 Boolean  @default(true) @map("aba_enabled")
  abaAccountName             String?  @map("aba_account_name")
  abaAccountNumber           String?  @map("aba_account_number")
  abaInstructions            String?  @map("aba_instructions")
  abaQrImageUrl              String?  @map("aba_qr_image_url")
  abaCustomerNote            String?  @map("aba_customer_note")
  primaryColor                         String?  @map("primary_color")
  telegramOrderNotificationsEnabled    Boolean  @default(true) @map("telegram_order_notifications_enabled")
  /** Public Telegram username customers open from FAQ. Bare name, no @. */
  telegramSupportUsername              String?  @map("telegram_support_username")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model PickupLocation {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  address      String
  instructions String?
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, sortOrder])
  @@map("pickup_locations")
}

model Faq {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  question   String
  answer     String
  questionKm String?  @map("question_km")
  answerKm   String?  @map("answer_km")
  /** Reserved from earlier migration — unused in EN/KM storefront. */
  questionZh String?  @map("question_zh")
  answerZh   String?  @map("answer_zh")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, sortOrder])
  @@map("faqs")
}

/**
 * Tenant-scoped campaign.
 * Money discounts (percentage/fixed): only one eligible applies per order (newest wins).
 * buy_one_get_one: product-scoped same-SKU free units; mutually exclusive with product-level
 * sale display on that SKU; may coexist with a cart-level money discount on paid subtotal.
 */
model Promotion {
  id                    String                 @id @default(cuid())
  tenantId              String                 @map("tenant_id")
  name                  String
  bannerText            String?                @map("banner_text")
  type                  PromotionDiscountType
  /**
   * Percentage points (1–100), fixed amount in minor currency units,
   * or 1 for buy_one_get_one (buy 1 get 1 free — fixed rule).
   */
  value                 Int
  minimumSubtotalMinor  Int?                   @map("minimum_subtotal_minor")
  startsAt              DateTime?              @map("starts_at")
  endsAt                DateTime?              @map("ends_at")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products PromotionProduct[]

  @@index([tenantId, isActive, createdAt])
  @@map("promotions")
}

/** Eligible SKUs for buy_one_get_one — each SKU gifts itself only (no cross-SKU). */
model PromotionProduct {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  promotionId String   @map("promotion_id")
  productId   String   @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([tenantId, productId])
  @@index([productId])
  @@map("promotion_products")
}
